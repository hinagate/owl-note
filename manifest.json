{
  "manifest_version": 3,
  "name": "OWL-Note: Markdown Notebook, Save AI Chats & Tab Transcriber",
  "short_name": "OWL-Note",
  "version": "2.3.48",
  "description": "Free Markdown notebook for your browser. Save & rebuild AI chats, transcribe tab audio, and search with local RAG. Auto-syncs free.",
  "permissions": ["bookmarks", "storage", "unlimitedStorage", "contextMenus", "activeTab", "scripting", "identity", "offscreen", "tabCapture"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'" },
  "optional_host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "action": {
    "default_title": "Open OWL-Note",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "service-worker.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
