{
  "name": "owl-note",
  "version": "2.3.9",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:release": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "eval:retrieval": "node eval/run-retrieval.mjs",
    "eval:answers": "node eval/run-answers.mjs",
    "icons": "node scripts/icon-from-source.mjs",
    "build": "node esbuild.config.mjs && node scripts/icon-from-source.mjs",
    "build:prod": "node esbuild.config.mjs --prod && node scripts/icon-from-source.mjs && node scripts/audit-release.mjs dist",
    "audit:release": "node scripts/audit-release.mjs dist",
    "pack": "node scripts/audit-release.mjs dist && node scripts/pack.mjs",
    "release": "npm run build:prod && npm run test:release && npm run pack"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "dompurify": "^3.1.0",
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.17.0",
    "mammoth": "^1.12.0",
    "marked": "^12.0.0",
    "marked-highlight": "^2.1.1",
    "marked-katex-extension": "^5.1.10",
    "minisearch": "^7.2.0",
    "spark-md5": "^3.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "vitest": "^1.6.0"
  }
}
